# LLM Provider 선택: gemini | anthropic | ollama  (기본: gemini)
LLM_PROVIDER=gemini

# Gemini Free Tier 사용 시 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=

# Anthropic 사용 시 (LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# 에이전트별 모델 오버라이드 (선택)
# 기본값은 provider별로 자동 선택됨
# WARROOM_TRIAGE_MODEL=gemini/gemini-2.5-flash-lite
# WARROOM_ANALYST_MODEL=gemini/gemini-2.5-flash
# WARROOM_FIXER_MODEL=gemini/gemini-2.5-flash

# true: LLM 호출 없이 mock 응답으로 전체 플로우 검증
MOCK_PIPELINE=false

# Notifier 백엔드: console | slack | both  (기본: both)
# both: ConsoleNotifier + SlackNotifier 동시 동작 (Slack은 URL 없으면 dry-run)
WARROOM_NOTIFIER=both

# Slack — Phase 2 이후 (chat.postMessage 기반)
# SLACK_BOT_TOKEN=xoxb-...                 # OAuth & Permissions > Bot User OAuth Token
# SLACK_SIGNING_SECRET=...                 # Basic Information > App Credentials > Signing Secret (Phase 3 서명검증용)
# SLACK_CHANNEL=#warroom-alerts            # 메시지 보낼 채널 (Phase 2 이후 사용)
#
# 구 방식 (Incoming Webhook, Phase 2 재작성 전까지 호환)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_DRY_RUN_LOG=./output/slack_payloads.jsonl

# Webhook 서명 검증 (운영 환경에서는 반드시 설정)
# - SENTRY_CLIENT_SECRET: Sentry Integration 설정의 Client Secret
#   미설정 시 X-Sentry-Signature 검증을 건너뜀 (dev 한정)
# - WARROOM_DATADOG_TOKEN: Datadog webhook 의 커스텀 헤더 X-Warroom-Token 으로 전달할 공유 토큰
# - SLACK_SIGNING_SECRET: Slack App 의 Basic Information > Signing Secret.
#   /slack/interactions 요청을 v0=HMAC-SHA256("v0:{ts}:{body}", secret) 로 검증.
#   미설정 시 dev 모드 — 검증 skip.
# SENTRY_CLIENT_SECRET=
# WARROOM_DATADOG_TOKEN=
# SLACK_SIGNING_SECRET=

# 애플리케이션 TZ (모든 timestamp 기준). 기본 UTC.
# APP_TZ=UTC
# APP_TZ=Asia/Seoul

# Graceful shutdown 시 in-flight 파이프라인을 대기할 grace 시간 (초). 기본 30.
# 초과 시 task cancel + status FAILED 자동 마킹 (startup 의 recover_stale_analyzing 과 짝).
# WARROOM_SHUTDOWN_GRACE_SECONDS=30.0

# 로깅 (Phase 6.1)
# - WARROOM_LOG_LEVEL: DEBUG / INFO / WARNING / ERROR / CRITICAL (기본 INFO)
# - WARROOM_LOG_FORMAT: human (기본) | json — json 은 observability 파이프라인 친화
# WARROOM_LOG_LEVEL=INFO
# WARROOM_LOG_FORMAT=human

# 데이터베이스 — dev/prod=MySQL, test/ci=in-memory SQLite
# 미설정 시 기본은 ./data/warroom.db (SQLite, 로컬 첫 실행 편의)
#
# 스키마 초기화 정책:
#   - SQLite : 서버/데모 lifespan 에서 metadata.create_all 자동 실행 (셋업 불필요)
#   - MySQL  : 자동 실행 안 함. 반드시 `uv run alembic upgrade head` 선행
#
# MySQL 사용 시 connection 세션 TZ 도 UTC 강제 (서버는 docker-compose 에서 이미 UTC).
# init_command 의 인용부호는 URL 인코딩 필요: ' = %27, + = %2B
# DATABASE_URL=mysql+asyncmy://warroom:warroom@localhost:3306/warroom?init_command=SET%20time_zone%3D%27%2B00:00%27
# DATABASE_URL=sqlite+aiosqlite:///:memory:

# GitHub App (승인된 패치를 PR 로 생성)
# - GITHUB_REPO 만 빈 값이거나 App 환경변수가 비면 dry-run (./output/github_payloads.jsonl)
# - 셋 다 채우면 실 GitHub API 호출
# GITHUB_REPO=owner/repo
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./.secrets/warroom-app.private-key.pem
# GITHUB_INSTALLATION_ID=

# Sentry Issue Lookup tool (Phase 6.2) — Analyst Agent 가 실 stacktrace / 발생 컨텍스트 조회.
# - SENTRY_AUTH_TOKEN: Sentry org settings → Custom Integrations 의 Internal Integration 의
#   Auth Token. 필요한 권한: Issue & Event : Read
# - SENTRY_ORG: warroom (URL warroom.sentry.io 의 slug)
# 둘 다 미설정 시 mock 응답으로 자동 fallback (tool 호출이 LLM 컨텍스트에서 fail 하지 않게).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=warroom

# Warroom 자체의 self-monitoring (dogfooding) — Warroom 의 unhandled exception 을
# Sentry 로 capture. DSN 미설정 시 비활성 (테스트 / dev 안전).
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
